                    for _, coin in ipairs(coinsToFarm) do
                        if not AutoFarmCoins then break end
                        if coin and coin.Parent and rootPart.Parent then
                            local distance = (rootPart.Position - coin.Position).Magnitude
                            local speed = _G.FarmSpeed or 50
                            local timeTaken = distance / speed
                            if timeTaken < 0.3 then timeTaken = 0.3 end
                            
                            if currentTween then
                                currentTween:Cancel()
                            end
                            
                            local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                            currentTween = TweenService:Create(rootPart, tweenInfo, {CFrame = coin.CFrame + Vector3.new(0, 2, 0)})
                            currentTween:Play()
                            
                            while currentTween.PlaybackState == Enum.PlaybackState.Playing and coin.Parent and AutoFarmCoins do
                                if (rootPart.Position - coin.Position).Magnitude < 3 then
                                    break
                                end
                                task.wait(0.05)
                            end
                            
                            CoinsCollected = CoinsCollected + 1
                            updateCoinStats(true)
                            
                            -- บังคับหน่วงเวลาเป๊ะๆ 0.67 วินาทีตามที่คุณขอ ป้องกัน Error 267 100%
                            task.wait(0.67)
                        end
                    end
                end
            end)
        else
            if currentTween then
                currentTween:Cancel()
                currentTween = nil
            end
            task.wait(1)
        end
        updateCoinStats(AutoFarmCoins)
    end
end)

