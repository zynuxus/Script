local function sendNotify(title, content, duration)
    if _G.ScriptSettings.NotificationsEnabled then
        Fluent:Notify({
            Title = title,
            Content = content,
            Duration = duration or 3
        })
    end
end

local function sendDiscordWebhook(title, description, color)
    if not _G.ScriptSettings.WebhookEnabled or _G.ScriptSettings.WebhookURL == "" or not RequestFunc then return end
    pcall(function()
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = description,
                ["color"] = color or 3447003,
                ["footer"] = { ["text"] = "Zynuxus MM2 Hub • " .. os.date("%H:%M:%S") }
            }}
        }
        RequestFunc({
            Url = _G.ScriptSettings.WebhookURL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
    end)
end

